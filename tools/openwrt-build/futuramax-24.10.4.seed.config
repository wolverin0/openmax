# FuturaMAX FMX-0011 seed config — OpenWrt v24.10.4, ath79/generic
# Purpose: stock 24.10.4 + ath10k spectral scan (CONFIG_RELAY) + full mac80211/ath debugfs.
# Apply: cp this to openwrt/.config && make defconfig && ./scripts/diffconfig.sh > futuramax.diffconfig
# Devices: LAP-120 (lab AP), LiteBeam AC Gen2, NanoStation 5AC, NanoStation Loco 5AC (testbed CPEs). All WA board, QCA988x Wave 1.
# NOTE: 24.10.4 has NO ubnt_lap-gps profile (sysid 0xe7fd) — the testbed AP plan must use LAP-120 or resolve this first.
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ath79_generic_DEVICE_ubnt_lap-120=y
CONFIG_TARGET_DEVICE_ath79_generic_DEVICE_ubnt_litebeam-ac-gen2=y
CONFIG_TARGET_DEVICE_ath79_generic_DEVICE_ubnt_nanostation-ac=y
CONFIG_TARGET_DEVICE_ath79_generic_DEVICE_ubnt_nanostation-ac-loco=y
# Radio debug surface — the reason for this build
CONFIG_PACKAGE_MAC80211_DEBUGFS=y
CONFIG_PACKAGE_ATH_DEBUG=y
CONFIG_PACKAGE_ATH_SPECTRAL=y
CONFIG_PACKAGE_ATH_DFS=y
# Bench conveniences (no radio behaviour change)
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_iw-full=y
CONFIG_PACKAGE_ethtool=y
# Per-package logs under logs/<pkg>/compile.txt (diagnostics only)
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
# No target gdb: not needed for the images; gdb-15.2 hit a host-compiler segfault (2026-09-26)
CONFIG_TOOLCHAINOPTS=y
# CONFIG_GDB is not set
